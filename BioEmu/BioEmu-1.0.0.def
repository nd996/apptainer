Bootstrap: docker
From: ubuntu:22.04

%environment
    # Set the path where BioEmu should install its Colabfold/Alphafold dependencies.
    # This ensures the installation is contained within the image.
    export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/bin/python3"
    # Set locale for compatibility
    export LC_ALL=C
    export LANG=C

%post
    export BIOEMU_VERSION="1.1.0"
    export BIOEMU_COLABFOLD_DIR="/opt/bioemu_colabfold"
    export DEBIAN_FRONTEND=noninteractive

    # Install Python, pip, git, patch, and other necessary utilities
    apt-get update
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        git \
        wget \
        patch \
        libopenmpi-dev \
        && rm -rf /var/lib/apt/lists/*

    # Create a symlink for 'python' command
    update-alternatives --install /usr/bin/python python /usr/bin/python3 1

    # Create the directory for Colabfold setup
    mkdir -p ${BIOEMU_COLABFOLD_DIR}

    # Install BioEmu and all its Python dependencies (including PyTorch)
    echo "Installing bioemu via pip..."
    pip install bioemu==${BIOEMU_VERSION}

    # The first time bioemu is used to sample structures, it will also setup
    # Colabfold on a separate virtual environment for MSA and embedding
    # generation. By default this setup uses the ~/.bioemu_colabfold directory,
    # but if you wish to have this changed please manually set the
    # BIOEMU_COLABFOLD_DIR environment variable accordingly before sampling for
    # the first time.
    echo "Triggering Colabfold dependency setup (requires internet)..."
    python -m bioemu.sample --sequence GYDPETGTWG --num_samples 10 --output_dir /tmp/test-chignolin

    # Clean up the temporary test run directory
    rm -rf /tmp/test-chignolin
    unset DEBIAN_FRONTEND

    echo "BioEmu installation and Colabfold setup complete."

%runscript
    # The default entry point for the container.
    # It executes the bioemu.sample module with all arguments passed to the container.
    echo "Running BioEmu sampling..."
    exec python -m bioemu.sample "$@"

%labels
    Software "BioEmu"
    Version "1.1.0"
    SourceURL "https://github.com/microsoft/bioemu"
    Description "Inference code for scalable emulation of protein equilibrium ensembles with generative deep learning."

%help
    This container encapsulates the BioEmu deep learning model for protein equilibrium ensemble sampling.

    **To Build the image:**
    apptainer build BioEmu.sif BioEmu.def

    **To Run the image (requires GPU):**
    apptainer run --nv BioEmu.sif [BioEmu arguments]

    **Example Usage (sampling 100 structures for a test sequence):**
    apptainer run --nv BioEmu.sif --sequence GYDPETGTWG --num_samples 100 --output_dir /path/to/results
