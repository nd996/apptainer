BootStrap: docker
From: ubuntu:{{ VERSION }}

# References used:
# https://gitlab.cern.ch/meehan/root-builds/-/blob/master/Dockerfile?ref_type=heads
# https://github.com/root-project/root-docker/blob/master/ubuntu20/Dockerfile

%arguments
	VERSION=18.04
	ACQU_URL=https://github.com/A2-Collaboration/acqu
	ACQU_COMMIT=b7571696ec72e2b08d64d7640f9ed5a39eddb9f6
	ACQU_INSTALL_PREFIX=/opt/acqu
	ROOT_URL=https://root.cern/download/
	ROOT_BIN=root_v5.34.34.source.tar.gz
	ROOT_CXX_FLAGS=-D_GFAL2_API_ -std=c++11 -I/usr/include/glib-2.0 -I/usr/lib/x86_64-linux-gnu/glib-2.0/include
	ROOT_INSTALL_PREFIX=/opt/root
	ROOT_ENABLE=-Dbuiltin_gsl=ON -Dpython=ON 
	ROOT_DISABLE=""

%environment
	export LANG="C.UTF-8"
	export ACQUSYS={{ ACQU_INSTALL_PREFIX }}
	export ROOTSYS={{ ROOT_INSTALL_PREFIX }}
	export PATH="$ROOTSYS/bin:$ACQUSYS/bin/:$PATH"
	export PYTHONPATH="$ROOTSYS/lib:$PYTHONPATH"
	export LD_LIBRARY_PATH="$ROOTSYS/lib:$ACQUSYS/lib:$LD_LIBRARY_PATH"
	export CLING_STANDARD_PCH="none"

# Copy some files to the root of the container
%files
	packages packages
	packages_acqu packages_acqu
	fix-cmath-include.patch fix-cmath-include.patch
	fix-gls-URL.patch fix-gls-URL.patch
	# FIXME: for debugging only
	root_v5.34.34.source.tar.gz root_v5.34.34.source.tar.gz

%post
   	echo "Inside the container, setting things up..."
	export DEBIAN_FRONTEND=noninteractive
	apt-get -y update
	ln -sf /usr/share/zoneinfo/UTC /etc/localtime 
	apt-get -y install $(cat packages) wget

	# set gcc v4.8 as default else ROOT doesn't build
	update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-4.8 10
	update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-4.8 10
	############################################################################
	# Download and build ROOT                                                  #
	############################################################################
	mkdir /build && cd /build
	#FIXME: 
	# wget {{ ROOT_URL }}{{ ROOT_BIN }}
	mv /{{ ROOT_BIN }} .
	# above for debugging only
	tar -xzvf {{ ROOT_BIN }} && rm -f {{ ROOT_BIN }} && cd root
	# fix gsl download link in 'cmake/modules/SearchInstalledSoftware.cmake'
	patch -p0 < /fix-gls-URL.patch
	# fix cmath include in `tmva/src/RuleFitParams.cxx`
	patch -p0 < /fix-cmath-include.patch

	# Build ROOT
	cd build
	PYTHON_MINOR_VERSION=$(python3 -c 'import sys; print(".".join(map(str, sys.version_info[:2])))')
	cmake \
		-DCMAKE_CXX_STANDARD=11 \
		-DCMAKE_CXX_FLAGS="{{ ROOT_CXX_FLAGS }}" \
		{{ ROOT_ENABLE }} \
		{{ ROOT_DISABLE }} \
		-DCMAKE_INSTALL_PREFIX="{{ ROOT_INSTALL_PREFIX }}" \
		-Dpython=ON \
		-DPYTHON_EXECUTABLE=$(command -v python3) \
		-DPYTHON_LIBRARIES=/usr/lib/python${PYTHON_MINOR_VERSION} \
		-DPYTHON_INCLUDE_DIRS=/usr/include/python${PYTHON_MINOR_VERSION} \
		..
	cmake -L .
	cmake --build . -- -j$(($(nproc)-2))
	cmake --build . --target install
	# Clean up ROOT source directory
	cd / && rm -rf /build

	echo "{{ ROOT_INSTALL_PREFIX }}/lib" >> /etc/ld.so.conf 
	ldconfig

	############################################################################
    # Install ACQU & dependencies											   #
	############################################################################
    # Install ACQU dependencies
	apt-get -y install $(cat /packages_acqu)
    rm -rf /var/lib/apt/lists/*
    
    # ACQU setup using git clone
	cd /opt && git clone {{ ACQU_URL }} acqu_source && cd acqu_source
	# Ensure we are on the last commit in case things change
	git reset --hard {{ ACQU_COMMIT }}
    # Build ACQU
    mkdir build && cd build
	cmake \
		-DLIBRARY_OUTPUT_PATH="{{ ACQU_INSTALL_PREFIX }}/lib" \
		-DEXECUTABLE_OUTPUT_PATH="{{ ACQU_INSTALL_PREFIX }}/bin" \
		..
	cmake -L .
	cmake --build . -- -j$(($(nproc)-2))


# This is what happens when you run the container...
%runscript
	echo Run 'root' or 'AcquRoot' for example
	# exec root -b
	exec "$@"

%help
    Some help text goes here.
